# Base URL of the backend API (no trailing slash).
# Backend on Vercel: https://sinarberkah-backend.vercel.app
# Local backend    : http://localhost:4000 (C:\Projects\sinarberkah-backend, npm run dev -- -p 4000)
# Required in production (the build fails if it is empty). In development, empty means the local backend.
API_BASE_URL=https://sinarberkah-backend.vercel.app

# Public site URL, used for the sitemap, robots, and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret for the POST /api/revalidate endpoint, called by the backend when an admin saves data.
# Use the same random text as REVALIDATE_SECRET in the backend.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If empty, the endpoint is off and new data shows up after the 1-hour cache expires.
REVALIDATE_SECRET=

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1
