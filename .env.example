# Base URL of the backend API (no trailing slash).
# Backend on Vercel: https://sinarberkah-backend.vercel.app
# Local backend    : http://localhost:4000 (C:\Projects\sinarberkah-backend, bun run dev -- --port 4000)
# Required in production. In development, empty falls back to http://localhost:4000.
API_BASE_URL=https://sinarberkah-backend.vercel.app

# Public custom domain serving uploaded media from R2 (no trailing slash).
PUBLIC_MEDIA_PUBLIC_DOMAIN=https://media-sb.raflisahrul.my.id

# Public site URL, used for canonical URLs, sitemap.xml, robots.txt, and metadata.
PUBLIC_SITE_URL=http://localhost:3000

# Secret for the POST /api/revalidate endpoint, called by the backend when an admin saves data.
# Use the same random text as REVALIDATE_SECRET in the backend.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If empty, the endpoint returns 503 and data refreshes on demand/SSR.
REVALIDATE_SECRET=
