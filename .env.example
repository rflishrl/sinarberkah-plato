# URL dasar API backend (tanpa slash di akhir).
# Backend di Vercel : https://sinarberkah-backend.vercel.app
# Backend lokal     : http://localhost:4000 (C:\Projects\sinarberkah-backend, npm run dev -- -p 4000)
# Jika dikosongkan: pengembangan memakai backend lokal, produksi memakai backend Vercel di atas.
API_BASE_URL=https://sinarberkah-backend.vercel.app

# URL publik situs, dipakai untuk sitemap, robots, dan metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Rahasia untuk endpoint POST /api/revalidate, dipanggil backend saat admin menyimpan data.
# Isi dengan teks acak yang sama dengan REVALIDATE_SECRET di backend.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Jika kosong, endpoint mati dan data baru tampil setelah cache 1 jam habis.
REVALIDATE_SECRET=
